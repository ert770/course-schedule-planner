{
  "name": "course-planner-server",
  "version": "1.0.0",
  "type": "module",
  "description": "個人化課表規劃推薦系統 - Backend",
  "main": "src/app.js",
  "scripts": {
    "dev": "node --watch src/app.js",
    "start": "node src/app.js",
    "test": "node --test \"test/**/*.test.js\"",
