node_modules/

# Environment variables
.env
.env.local
.env.*.local

# SSL / certificates
*.pem
server/ca.pem
server/certs/

# Build outputs
dist/
build/
.next/
out/

# 文件產生過程的工作目錄，不是交付物。
# `tmp/` 放 PDF 產生腳本與逐頁渲染檢查用的 PNG（驗收中間產物）；
# `output/` 放產生器的輸出。要保留給人看的 PDF 請放進 `docs/`，
# 那裡才是交付物的位置（例如 `docs/欄位盤點與待修正清單.pdf`）。
tmp/
output/

# OS files
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Profile migration backups contain user data and must remain local.
server/backups/

# Chat history is written at runtime and accumulates real student
# conversations tied to a stable student ID and timestamp. It must never be
# committed — Git history is durable and broadly replicated, so even a later
# deletion would not remove already-pushed records. The file stays on disk
# for the local JSON-fallback runtime path; only tracking is disabled.
server/data/chat_history.json
