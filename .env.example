PORT=3001
GEMINI_API_KEY=your_gemini_api_key_here
# AI Agent 使用的 LLM provider。model id 一律由此指定，不寫死在程式裡。
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace_with_a_long_random_secret
# #33 隱私基礎。兩者必須由部署平台提供，正式環境不可使用範例值。
PRIVACY_ENFORCEMENT_ENABLED=false
PRIVACY_STORE=mysql
ANALYTICS_ID_SECRET=replace_with_an_independent_random_secret_at_least_32_chars
# 32 bytes Base64，例如由密鑰管理系統產生；不可與 SESSION_SECRET 共用。
PRIVACY_DATA_KEY_V1=replace_with_base64_encoded_32_byte_key
VITE_API_BASE=http://localhost:3001/api
# 本機隔離驗收可改用 VITE_API_BASE=/api，並將代理目標設為測試後端。
VITE_API_PROXY_TARGET=
# 僅供 BROWSER* 隔離 fixture 的開發期 E2E；正式環境不得啟用。
VITE_E2E_BYPASS_SETUP=false

DB_HOST=your_mysql_host
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=defaultdb
DB_SSL_CA_PATH=server/ca.pem

# 選填。Course_Reviews 全表查詢結果的快取時間（毫秒），預設 60000（60 秒）。
REVIEWS_CACHE_TTL_MS=60000
